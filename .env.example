# Copy to .env for local development. Never commit real secrets.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
# Generate with: .venv/Scripts/python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

SQLSERVER_HOST=localhost
SQLSERVER_NAME=sms_platform
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_PORT=1433

SMS_API_TOKEN=
SMS_API_URL=https://sms.mtncongo.net/api/sms/
SMS_SENDER=ElemboTech
SMTP_ENCRYPTION_KEY=

MOMO_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CURRENCY=XAF

AIRTEL_API_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY_CODE=CG
AIRTEL_CURRENCY=XAF

# Set these in production behind HTTPS.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
